# Copiar a .env y ajustar valores
POSTGRES_DB=stylo
POSTGRES_USER=stylo
POSTGRES_PASSWORD=stylo
POSTGRES_PORT=5434

# Backend (Spring)
DB_URL=jdbc:postgresql://localhost:5434/stylo
DB_USER=stylo
DB_PASSWORD=stylo
# Mínimo 32 caracteres (HS256)
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRATION_HOURS=8
# Orígenes permitidos (admite patrones). En producción use el dominio real, p. ej. https://app.mipeluqueria.com
# Superadmin de la plataforma (se crea al arrancar si no existe ninguno)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=cambia-esta-clave

CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
SERVER_PORT=8085
